# =========================================================================
# Kost Tiga Dara — app terpadu (Dashboard analitik + Mini App Operasional)
# Salin file ini menjadi .env.local lalu isi nilainya. JANGAN commit .env.local.
#
# Gabungan dari .env.example kedua repo lama (Dashboard Figma + miniapp-kost),
# terdeduplikasi pada Fase 0 migrasi. Lihat docs/MIGRASI.md untuk daftar kunci
# yang sengaja dibuang beserta alasannya.
# =========================================================================

# ---- Clerk (WAJIB) — satu instance dipakai Dashboard & Ops ----
# Login, register, lupa password, OAuth Google/Apple ditangani Clerk
# (server kita tidak pernah menyimpan/melihat password).
# Clerk Dashboard → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_isi_dari_clerk_dashboard
CLERK_SECRET_KEY=sk_test_isi_dari_clerk_dashboard
# Clerk Dashboard → Webhooks → endpoint {DOMAIN}/api/webhooks/clerk, event
# "user.created" → salin Signing Secret. WAJIB agar akun baru otomatis
# berstatus "pending" (menunggu approval Owner) di KEDUA namespace metadata.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_isi_dari_clerk_dashboard
# Dibaca implisit oleh @clerk/nextjs (tidak dirujuk kode kita secara langsung).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Opsional: hanya bila App Clerk memakai domain production custom (bukan
# *.clerk.accounts.dev). Mempersempit CSP agar tidak wildcard — lihat R7 §6.
# Nilai persis ada di Clerk Dashboard → Domains.
# CLERK_FRONTEND_API_ORIGIN=https://clerk.domain-anda.com

# ---- 2FA / TOTP (Google Authenticator) — KUSTOM, bukan Clerk ----
# MFA bawaan Clerk hanya ada di paket berbayar. 2FA di app ini diimplementasikan
# sendiri (`speakeasy` + cookie step-up ber-tanda-tangan `jose`) sebagai lapisan
# DI ATAS sesi Clerk. String acak panjang, WAJIB di produksi — tanpa ini semua
# orang diminta ulang kode 2FA setiap server restart/deploy.
# Secret TOTP per-user ada di Clerk privateMetadata (TIDAK di env ini).
TOTP_STEPUP_SECRET=ganti_dengan_string_acak_panjang

# ---- Turso — database bersama Dashboard & Ops ----
TURSO_DATABASE_URL=libsql://nama-db-organisasi.turso.io
TURSO_AUTH_TOKEN=isi_token_turso_di_sini
# Untuk uji lokal tanpa cloud, bisa pakai file SQLite:
# TURSO_DATABASE_URL=file:./data/local.db

# ---- Turso app Inventory Stock (DB terpisah) — monitoring + tulis pemakaian/pembelian ----
# Token BUTUH izin tulis sejak integrasi HTTP dipotong (lib/inventory.ts).
INVENTORY_DATABASE_URL=libsql://inventory-db.turso.io
INVENTORY_AUTH_TOKEN=isi_token_read_write

# ---- Upstash Redis — lock, idempotensi requestId, rate limit ----
# Menggantikan express-rate-limit (in-memory tidak andal di serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Google OAuth — Sheets & Drive (SKEMA UTAMA) ----
# Dipakai kalau ketiganya terisi; kalau tidak, jatuh ke Service Account di bawah.
#
# Alasan pindah ke OAuth: aplikasi penghuni Teman Rara mengunggah berkas (bukti
# bayar, foto pengaduan, scan identitas) dengan kredensial OAuth-nya sendiri.
# Berkas itu dimiliki akun tersebut, sehingga service account Ops tidak bisa
# membacanya — padahal layar verifikasi bukti bayar & review pendaftaran harus
# bisa. Memakai kredensial yang sama menyelesaikan itu.
#
# Refresh token WAJIB dibuat dengan DUA scope sekaligus:
#   https://www.googleapis.com/auth/drive
#   https://www.googleapis.com/auth/spreadsheets
# Scope spreadsheets tetap perlu karena handler pembayaran-sewa masih membaca
# tabel harga Invoice Generator dari Google Sheets.
#
# Akun OAuth juga harus punya akses edit ke semua folder DRIVE_FOLDER_* di bawah
# DAN ke spreadsheet Invoice Generator DP/Sewa.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---- Google Service Account — Sheets & Drive (FALLBACK) ----
# Dipakai hanya bila trio OAuth di atas kosong. Share semua spreadsheet & folder
# Drive ke email service account ini. Menghapus GOOGLE_REFRESH_TOKEN =
# rollback instan ke skema ini, tanpa deploy ulang.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key: satu baris, \n literal untuk baris baru
GOOGLE_PRIVATE_KEY=

# ---- Spreadsheet ID ----
SHEET_ID_AUDIT_LOG=
SHEET_ID_PINDAH_KAMAR=
SHEET_ID_CHECKOUT=

# ---- Pengiriman invoice (Gmail API) ----
# Kredensial OAuth TERPISAH dari service account di atas — hanya scope gmail.send.
# Isi CLIENT_ID/SECRET dari OAuth client "Desktop app", lalu jalankan
#   npx tsx scripts/gmail-token.ts
# untuk mendapatkan REFRESH_TOKEN. Selama consent screen masih "Testing",
# refresh token akun @gmail.com kedaluwarsa tiap 7 hari — publish app agar awet.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# APPS_SCRIPT_INVOICE_DP_URL / APPS_SCRIPT_INVOICE_SEWA_URL / APPS_SCRIPT_TOKEN
# sudah TIDAK dipakai sejak invoice dirender & dikirim langsung oleh app
# (src/lib/invoice/). Boleh dihapus dari .env.local dan Vercel.

# ---- Folder Drive untuk upload bukti (ID folder) ----
# DRIVE_FOLDER_PENGHUNI = folder "Data Penghuni (KTP/SIM/Identitas)"
# DRIVE_FOLDER_KONTRAK  = folder "Kontrak Penghuni"
# Berkas di kedua folder ini dinamai (Jenis Docs)-(ID Penghuni)-(No Kamar)-(Nama),
# lihat src/lib/drive-dokumen.ts.
DRIVE_FOLDER_PENGHUNI=
DRIVE_FOLDER_KONTRAK=
DRIVE_FOLDER_PEMBAYARAN=
DRIVE_FOLDER_NOTA=
DRIVE_FOLDER_FEEDBACK=
DRIVE_FOLDER_MAINTENANCE=

# ---- Arsip PDF invoice ke Drive (opsional; kosong = tidak diarsip) ----
# Salinan tiap invoice yang terkirim disimpan ke sini. Gagal mengarsip TIDAK
# membatalkan pengiriman — invoice selalu bisa dibuat ulang dari data Turso.
DRIVE_FOLDER_INVOICE_SEWA=
DRIVE_FOLDER_INVOICE_DP=

# ---- Folder Drive per role Dashboard (POST /api/dashboard/documents) ----
# OPSIONAL. Selama kosong, endpoint membalas 503 { setup: true } — sama persis
# dengan perilaku Dashboard lama, yang data/drive-config.json-nya memang tidak
# pernah ada sehingga fitur ini tidak aktif. Isi dgn ID folder Drive yang sudah
# di-share ke GOOGLE_SERVICE_ACCOUNT_EMAIL untuk mengaktifkannya.
DRIVE_FOLDER_ROLE_OWNER=
DRIVE_FOLDER_ROLE_ADMIN=
DRIVE_FOLDER_ROLE_MARKETING=
DRIVE_FOLDER_ROLE_OPERASIONAL=
DRIVE_FOLDER_ROLE_SALES=

# ---- Integrasi aplikasi penghuni "Teman Rara" ----
# Ops menulis pengumuman langsung ke database (satu Turso bersama), tapi push
# notification hanya bisa dikirim aplikasi Teman Rara — kunci VAPID dan daftar
# langganan ada di sana. Dua kunci ini dipakai memanggil endpoint notifikasinya.
# Nilai OPS_SHARED_SECRET harus SAMA dengan yang di-set di aplikasi Teman Rara.
# Kalau dikosongkan, pengumuman tetap tersimpan dan tampil — hanya notifikasinya
# yang tidak terkirim, dan layarnya memberi tahu itu.
TEMAN_RARA_BASE_URL=
OPS_SHARED_SECRET=

# =========================================================================
# Kunci lama yang TIDAK dipakai lagi (jangan tambahkan kembali):
#   PUBLISH_KEY_CLERK, CLERK_PUBLISHABLE_KEY  → NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
#   JWT_SECRET                                → TOTP_STEPUP_SECRET
#   GOOGLE_OAUTH_CLIENT_ID/SECRET, APP_BASE_URL → login pengguna ditangani Clerk.
#     JANGAN keliru dengan GOOGLE_CLIENT_ID/SECRET di atas — itu OAuth untuk
#     akses Drive & Sheets dari server, bukan untuk login.
#   NODE_ENV                                  → ditetapkan Next.js sendiri
#   SHEETS_SPREADSHEET_ID, GOOGLE_SERVICE_ACCOUNT_JSON → skrip dump-formulas lama
# =========================================================================
